{
  "name": "r6operators-website",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": "Marco Vockner <me@marcovockner.dev>",
  "contributors": [
    "Daniel Werg (https://github.com/danielwerg)"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build:assets && npm run build:vite",
    "build:assets": "vite-node ./scripts/buildStaticAssets.ts",
    "build:vite": "vite-ssg build",
    "clean": "vite-node ./scripts/clean.ts",
    "dev": "vite",
    "format": "prettier **/* --ignore-path .gitignore --check --write",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "stylelint": "stylelint **/*.{vue,css,scss}",
    "stylelint:fix": "stylelint **/*.{vue,css,scss} --fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,vue}": "eslint --cache --fix",
    "*.{css,scss}": "stylelint --fix"
  },
  "dependencies": {
    "@vueform/multiselect": "^2.6.11",
    "normalize.css": "^8.0.1",
    "r6operators": "^2.12.0",
    "radix-vue": "^1.9.17",
    "slugify": "^1.6.6",
    "vue": "^3.5.21",
    "vue-collapsed": "^1.3.4"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@unhead/vue": "^2.0.14",
    "@vitejs/plugin-vue": "^6.0.1",
    "archiver": "^7.0.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unicorn": "^61.0.2",
    "eslint-plugin-vue": "^10.4.0",
    "fs-extra": "^11.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "sass": "^1.92.1",
    "sharp": "^0.34.3",
    "stylelint": "^16.24.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.5",
    "vite-node": "^3.2.4",
    "vite-ssg": "^28.1.0",
    "vite-svg-loader": "^5.1.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.7"
  },
  "engines": {
    "node": ">=18.12.0"
  }
}
